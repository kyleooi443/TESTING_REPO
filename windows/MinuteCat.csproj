<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>Minute-Cat</AssemblyName>
    <RootNamespace>MinuteCat</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Compile Include="Program.cs" />
    <EmbeddedResource Include="..\assets\cats_walk_a.png">
      <LogicalName>MinuteCat.cats_walk_a.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\cats_walk_b.png">
      <LogicalName>MinuteCat.cats_walk_b.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
